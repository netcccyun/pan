{
  "name": "pan-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "dev:admin": "nuxt dev admin --port 3001",
    "build": "pnpm build:site && pnpm build:admin",
    "build:site": "nuxt generate && node scripts/deploy.mjs site",
    "build:admin": "nuxt generate admin && node scripts/deploy.mjs admin",
    "postinstall": "nuxt prepare && nuxt prepare admin"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.152",
    "@iconify-json/simple-icons": "^1.2.101",
    "@nuxt/ui": "^4.12.0",
    "artplayer": "^5.4.0",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "hls.js": "^1.7.4",
    "marked": "17.0.6",
    "mpegts.js": "^1.8.2",
    "nuxt": "^4.6.4",
    "qrcode": "^1.5.4",
    "spark-md5": "^3.0.2",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "vue3-aplayer": "^2.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/spark-md5": "^3.0.5"
  }
}
